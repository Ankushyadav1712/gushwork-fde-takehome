PORT=3000
# The address Twilio, Mailgun and the links in texts use. Leave blank locally (http://localhost:PORT).
PUBLIC_URL=
DB_PATH=data/callback.db
BUSINESS_TZ=America/Chicago
# Demo mode (seeded jobs, demo clock, Demo controls). Blank = on locally, always off in production.
DEMO=
APP_PASSCODE=
# Signs the login cookie. Blank = one is generated once and kept in the database.
SESSION_SECRET=
INBOUND_TOKEN=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_PARSING=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MAILGUN_SIGNING_KEY=
